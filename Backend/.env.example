PORT=5000
NODE_ENV=development

# Frontend origins (comma-separated)
FRONTEND_URL=http://localhost:5173,https://hassan2163.github.io

# Gemini AI — get from https://aistudio.google.com/app/apikey
# ROTATE THIS KEY — never commit the real value
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase — get from https://supabase.com/dashboard/project/_/settings/api
# Use the SERVICE ROLE key (not anon key) — backend only, never expose to frontend
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# Apify — get from https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token_here

# Redis — for BullMQ job queues (Phase 3)
# Local: redis://localhost:6379
# Render/Upstash: rediss://your-redis-url
REDIS_URL=redis://localhost:6379
